<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Windows PE icon (File Explorer) -->
    <ApplicationIcon>Assets\avalonia-logo.ico</ApplicationIcon>

    <!-- AOT + Single-file publish (only affects dotnet publish, not F5 debug builds) -->
    <PublishAot>true</PublishAot>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- Release-only optimizations (avoid breaking debug F5) -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebuggerSupport>false</DebuggerSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <!-- Strip PDB debug symbols from publish output -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <!-- Exclude .resx files from AvaloniaResource; they are copied as Content for runtime loading -->
    <AvaloniaResource Include="Assets\**" Exclude="Assets\Languages\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Language .resx files are copied to output for runtime dynamic loading by LanguageService -->
    <Content Include="Assets\Languages\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <LinkBase>Assets\Languages\</LinkBase>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.10" />
  </ItemGroup>

  <!-- Strip PDB files from publish output (they come from NuGet packages) -->
  <Target Name="DeletePdbsAfterPublish" AfterTargets="Publish">
    <ItemGroup>
      <PdbsToDelete Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(PdbsToDelete)" />
    <Message Text="Stripped PDB files from publish output" Importance="High" />
  </Target>

  <!-- macOS: create .app bundle with icon after publish -->
  <Target Name="CreateMacAppBundle" AfterTargets="Publish"
          Condition="$([MSBuild]::IsOSPlatform('OSX')) Or '$(RuntimeIdentifier)' == 'osx-arm64' Or '$(RuntimeIdentifier)' == 'osx-x64'">
    <PropertyGroup>
      <AppBundleDir>$(PublishDir)../OssClientPro.app</AppBundleDir>
      <MacAppContents>$(AppBundleDir)/Contents</MacAppContents>
      <MacAppMacOS>$(MacAppContents)/MacOS</MacAppMacOS>
      <MacAppResources>$(MacAppContents)/Resources</MacAppResources>
    </PropertyGroup>

    <RemoveDir Directories="$(AppBundleDir)" />
    <MakeDir Directories="$(MacAppMacOS);$(MacAppResources)" />

    <!-- Copy the native binary -->
    <Copy SourceFiles="$(PublishDir)OssClientPro" DestinationFolder="$(MacAppMacOS)" />

    <!-- Copy native dependencies -->
    <ItemGroup>
      <MacNativeLibs Include="$(PublishDir)*.dylib" />
    </ItemGroup>
    <Copy SourceFiles="@(MacNativeLibs)" DestinationFolder="$(MacAppMacOS)" Condition="Exists('@(MacNativeLibs)')" SkipUnchangedFiles="true" />

    <!-- Copy Assets -->
    <Copy SourceFiles="$(PublishDir)Assets\Languages\**\*.*" DestinationFolder="$(MacAppResources)/Assets/Languages/%(RecursiveDir)" Condition="Exists('$(PublishDir)Assets')" />

    <!-- Generate Info.plist -->
    <WriteLinesToFile File="$(MacAppContents)/Info.plist"
                      Lines="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?&gt;
&lt;!DOCTYPE plist PUBLIC &quot;-//Apple//DTD PLIST 1.0//EN&quot; &quot;http://www.apple.com/DTDs/PropertyList-1.0.dtd&quot;&gt;
&lt;plist version=&quot;1.0&quot;&gt;
&lt;dict&gt;
    &lt;key&gt;CFBundleName&lt;/key&gt;
    &lt;string&gt;OssClientPro&lt;/string&gt;
    &lt;key&gt;CFBundleDisplayName&lt;/key&gt;
    &lt;string&gt;OSS Client Pro&lt;/string&gt;
    &lt;key&gt;CFBundleExecutable&lt;/key&gt;
    &lt;string&gt;OssClientPro&lt;/string&gt;
    &lt;key&gt;CFBundleIdentifier&lt;/key&gt;
    &lt;string&gt;com.camliar.ossclientpro&lt;/string&gt;
    &lt;key&gt;CFBundleVersion&lt;/key&gt;
    &lt;string&gt;1.0.0&lt;/string&gt;
    &lt;key&gt;CFBundleShortVersionString&lt;/key&gt;
    &lt;string&gt;1.0&lt;/string&gt;
    &lt;key&gt;CFBundlePackageType&lt;/key&gt;
    &lt;string&gt;APPL&lt;/string&gt;
    &lt;key&gt;CFBundleIconFile&lt;/key&gt;
    &lt;string&gt;AppIcon&lt;/string&gt;
    &lt;key&gt;NSHighResolutionCapable&lt;/key&gt;
    &lt;true/&gt;
&lt;/dict&gt;
&lt;/plist&gt;"
                      Overwrite="true" />

    <Message Text="Created macOS .app bundle at $(AppBundleDir)" Importance="High" />
  </Target>
</Project>
