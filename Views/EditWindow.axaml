<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OssClientPro.Views.EditWindow"
        Width="800" Height="600"
        MinWidth="400" MinHeight="300"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="*,Auto" Margin="12">
        <!-- Editable text area -->
        <TextBox x:Name="EditTextBox"
                 Grid.Row="0"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 FontFamily="Consolas,Courier New,monospace"
                 FontSize="13"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" />

        <!-- Bottom bar -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,8,0,0">
            <Button Grid.Column="1" Content="Save" Click="Save_Click" Margin="0,0,8,0" />
            <Button Grid.Column="2" Content="Cancel" Click="Cancel_Click" />
        </Grid>
    </Grid>
</Window>
